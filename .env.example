# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/soro-garage-doors

# Authentication
# Required for signed admin session cookie (image uploads on Vercel)
AUTH_SECRET=your-secret-key-here-use-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Admin Seed
ADMIN_SEED_EMAIL=admin@sorogaragedoors.ca
ADMIN_SEED_PASSWORD=ChangeThisPassword123!

# ------------------------------------------------------------
# SMTP — Squarespace custom email (Google Workspace)
# Squarespace does not host mail; Workspace uses Gmail SMTP.
# Create App Password: https://myaccount.google.com/apppasswords
# On Vercel: use port 465 (SSL). Port 587 often times out.
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@sorogaragedoors.ca
SMTP_PASSWORD=your-16-char-google-app-password
SMTP_FROM=info@sorogaragedoors.ca
LEAD_NOTIFICATION_EMAIL=info@sorogaragedoors.ca
BUSINESS_EMAIL=info@sorogaragedoors.ca

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://www.sorogaragedoors.ca
NEXT_PUBLIC_PHONE=647-299-0283
NEXT_PUBLIC_EMAIL=info@sorogaragedoors.ca

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# Google Places (Optional)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Media Storage
# Admin uploads are stored in MongoDB (StoredUpload) and served from /api/uploads/...
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
